set(CMAKE_SYSTEM_NAME "@ROSETTE_MICRO_ROS_TOOLCHAIN_SYSTEM_NAME@")
set(CMAKE_CROSSCOMPILING 1)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_C_COMPILER "@CMAKE_C_COMPILER@")
set(CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@")
set(CMAKE_ASM_COMPILER "@CMAKE_ASM_COMPILER@")

set(CMAKE_C_COMPILER_WORKS 1 CACHE INTERNAL "")
set(CMAKE_CXX_COMPILER_WORKS 1 CACHE INTERNAL "")

set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 17)

set(CMAKE_C_FLAGS_INIT "@ROSETTE_MICRO_ROS_COMMON_C_FLAGS@" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_INIT "@ROSETTE_MICRO_ROS_COMMON_CXX_FLAGS@" CACHE STRING "" FORCE)

set(CMAKE_C_FLAGS_RELEASE "@ROSETTE_MICRO_ROS_RELEASE_FLAGS@" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "@ROSETTE_MICRO_ROS_RELEASE_FLAGS@" CACHE STRING "" FORCE)

set(ROSETTE_MICRO_ROS_USE_PICO_TIME @ROSETTE_MICRO_ROS_USE_PICO_TIME_TEXT@ CACHE BOOL "")

set(__BIG_ENDIAN__ 0)
