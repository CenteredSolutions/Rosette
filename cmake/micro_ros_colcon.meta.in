{
  "names": {
    "tracetools": {
      "cmake-args": [
        "-DTRACETOOLS_DISABLED=ON",
        "-DTRACETOOLS_STATUS_CHECKING_TOOL=OFF"
      ]
    },
    "rosidl_typesupport": {
      "cmake-args": [
        "-DROSIDL_TYPESUPPORT_SINGLE_TYPESUPPORT=ON"
      ]
    },
    "rcl": {
      "cmake-args": [
        "-DBUILD_TESTING=OFF",
        "-DRCL_COMMAND_LINE_ENABLED=OFF",
        "-DRCL_LOGGING_ENABLED=OFF"
      ]
    },
    "rcutils": {
      "cmake-args": [
        "-DENABLE_TESTING=OFF",
        "-DRCUTILS_NO_FILESYSTEM=ON",
        "-DRCUTILS_NO_THREAD_SUPPORT=ON",
        "-DRCUTILS_NO_64_ATOMIC=ON",
        "-DRCUTILS_AVOID_DYNAMIC_ALLOCATION=ON"
      ]
    },
    "microxrcedds_client": {
      "cmake-args": [
        "-DUCLIENT_PIC=OFF",
        "-DUCLIENT_PROFILE_UDP=@ROSETTE_MICRO_ROS_UCLIENT_UDP@",
        "-DUCLIENT_PROFILE_TCP=OFF",
        "-DUCLIENT_PROFILE_DISCOVERY=@ROSETTE_MICRO_ROS_UCLIENT_UDP@",
        "-DUCLIENT_PROFILE_SERIAL=OFF",
        "-DUCLIENT_PROFILE_STREAM_FRAMING=@ROSETTE_MICRO_ROS_USE_CUSTOM_TRANSPORT@",
        "-DUCLIENT_PROFILE_CUSTOM_TRANSPORT=@ROSETTE_MICRO_ROS_USE_CUSTOM_TRANSPORT@",
        "-DUCLIENT_CUSTOM_TRANSPORT_MTU=@ROSETTE_MICRO_ROS_MAX_TRANSPORT_MTU@",
        "-DUCLIENT_UDP_TRANSPORT_MTU=@ROSETTE_MICRO_ROS_MAX_TRANSPORT_MTU@"
      ]
    },
    "rmw_microxrcedds": {
      "cmake-args": [
        "-DRMW_UXRCE_MAX_NODES=@ROSETTE_MICRO_ROS_MAX_NODES@",
        "-DRMW_UXRCE_MAX_PUBLISHERS=@ROSETTE_MICRO_ROS_MAX_PUBLISHERS@",
        "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=@ROSETTE_MICRO_ROS_MAX_SUBSCRIPTIONS@",
        "-DRMW_UXRCE_MAX_SERVICES=@ROSETTE_MICRO_ROS_MAX_SERVICES@",
        "-DRMW_UXRCE_MAX_CLIENTS=@ROSETTE_MICRO_ROS_MAX_CLIENTS@",
        "-DRMW_UXRCE_MAX_HISTORY=@ROSETTE_MICRO_ROS_MAX_HISTORY@",
        "-DRMW_UXRCE_MAX_TRANSPORT_MTU=@ROSETTE_MICRO_ROS_MAX_TRANSPORT_MTU@",
        "-DRMW_UXRCE_MAX_INPUT_BUFFER_SIZE=@ROSETTE_MICRO_ROS_MAX_INPUT_BUFFER_SIZE@",
        "-DRMW_UXRCE_MAX_OUTPUT_BUFFER_SIZE=@ROSETTE_MICRO_ROS_MAX_OUTPUT_BUFFER_SIZE@",
        "-DRMW_UXRCE_STREAM_HISTORY=@ROSETTE_MICRO_ROS_STREAM_HISTORY@",
        "-DRMW_UXRCE_TRANSPORT=@_rosette_micro_ros_transport@",
      ]
    }
  }
}
