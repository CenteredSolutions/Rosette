#!/usr/bin/env bash
set -euo pipefail

ROS_SETUP="@ROSETTE_MICRO_ROS_ROS_SETUP@"
MICRO_ROS_SETUP_SRC="@ROSETTE_MICRO_ROS_SETUP_SOURCE_DIR@"
WORKSPACE_DIR="@ROSETTE_MICRO_ROS_WORKSPACE_DIR_ESCAPED@"
TOOLCHAIN_FILE="@_rosette_micro_ros_toolchain_file@"
COLCON_META_FILE="@_rosette_micro_ros_colcon_meta_file@"
RUN_ROSDEP="@ROSETTE_MICRO_ROS_RUN_ROSDEP_TEXT@"

source_setup_file() {
  local setup_file="$1"
  local errexit_was_enabled=0
  local nounset_was_enabled=0

  case "$-" in
    *e*) errexit_was_enabled=1 ;;
  esac
  case "$-" in
    *u*) nounset_was_enabled=1 ;;
  esac

  set +e
  set +u
  source "${setup_file}"
  local source_status=$?

  if [[ "${nounset_was_enabled}" -eq 1 ]]; then
    set -u
  fi
  if [[ "${errexit_was_enabled}" -eq 1 ]]; then
    set -e
  fi

  return "${source_status}"
}

patch_libyaml_vendor_for_cmake4() {
  local vendor_cmake="$1"
  local policy_arg="-DCMAKE_POLICY_VERSION_MINIMUM=3.5"

  if [[ ! -f "${vendor_cmake}" ]]; then
    return 0
  fi
  if grep -Fq "${policy_arg}" "${vendor_cmake}"; then
    return 0
  fi

  perl -0pi -e \
    's/(list\(APPEND extra_cmake_args -DBUILD_TESTING=OFF\)\n)/$1  list(APPEND extra_cmake_args -DCMAKE_POLICY_VERSION_MINIMUM=3.5)\n/' \
    "${vendor_cmake}"
}

patch_rcutils_for_pico_time() {
  local rcutils_dir="$1"
  local rcutils_cmake="${rcutils_dir}/CMakeLists.txt"
  local time_source="${rcutils_dir}/src/time_pico.c"

  if [[ ! -f "${rcutils_cmake}" ]]; then
    return 0
  fi

  if ! grep -Fq "ROSETTE_MICRO_ROS_USE_PICO_TIME" "${rcutils_cmake}"; then
    perl -0pi -e \
      's/if\(WIN32\)\n  set\(time_impl_c src\/time_win32\.c\)\nelse\(\)\n  set\(time_impl_c src\/time_unix\.c\)\nendif\(\)/if(WIN32)\n  set(time_impl_c src\/time_win32.c)\nelseif(ROSETTE_MICRO_ROS_USE_PICO_TIME)\n  set(time_impl_c src\/time_pico.c)\nelse()\n  set(time_impl_c src\/time_unix.c)\nendif()/g' \
      "${rcutils_cmake}"
  fi

  cat > "${time_source}" <<'EOF'
// Pico/newlib rcutils time source for micro-ROS static library builds.

#include <stdint.h>

#include "rcutils/time.h"
#include "rcutils/types.h"

extern uint64_t time_us_64(void);

__attribute__((weak)) int64_t
rosette_micro_ros_epoch_time_us(void)
{
  return (int64_t)time_us_64();
}

static rcutils_ret_t
rosette_pico_steady_time_now(rcutils_time_point_value_t * now)
{
  if (now == 0) {
    return RCUTILS_RET_INVALID_ARGUMENT;
  }

  *now = (rcutils_time_point_value_t)(time_us_64() * 1000ull);
  return RCUTILS_RET_OK;
}

rcutils_ret_t
rcutils_system_time_now(rcutils_time_point_value_t * now)
{
  if (now == 0) {
    return RCUTILS_RET_INVALID_ARGUMENT;
  }

  *now = (rcutils_time_point_value_t)(rosette_micro_ros_epoch_time_us() * 1000ll);
  return RCUTILS_RET_OK;
}

rcutils_ret_t
rcutils_steady_time_now(rcutils_time_point_value_t * now)
{
  return rosette_pico_steady_time_now(now);
}

rcutils_ret_t
rcutils_raw_steady_time_now(rcutils_time_point_value_t * now)
{
  return rosette_pico_steady_time_now(now);
}
EOF
}

if [[ ! -f "${ROS_SETUP}" ]]; then
  echo "micro-ROS bootstrap requires a host ROS 2 installation at: ${ROS_SETUP}" >&2
  exit 1
fi

# A project virtualenv left active on PATH can shadow the system Python that
# carries catkin_pkg / colcon / empy, which the ament/rosidl build steps import.
# Fall back to the system interpreter when the active venv cannot import them.
if [[ -n "${VIRTUAL_ENV:-}" ]] && ! python3 -c 'import catkin_pkg' >/dev/null 2>&1; then
  echo "micro-ROS: active virtualenv lacks catkin_pkg; falling back to system Python" >&2
  PATH="/usr/bin:${PATH}"
  unset VIRTUAL_ENV
  hash -r 2>/dev/null || true
fi

mkdir -p "${WORKSPACE_DIR}/src"

if [[ -L "${WORKSPACE_DIR}/src/micro_ros_setup" ]]; then
  EXISTING_TARGET="$(readlink "${WORKSPACE_DIR}/src/micro_ros_setup")"
  if [[ "${EXISTING_TARGET}" != "${MICRO_ROS_SETUP_SRC}" ]]; then
    rm -f "${WORKSPACE_DIR}/src/micro_ros_setup"
  fi
fi

if [[ ! -e "${WORKSPACE_DIR}/src/micro_ros_setup" ]]; then
  ln -s "${MICRO_ROS_SETUP_SRC}" "${WORKSPACE_DIR}/src/micro_ros_setup"
fi

source_setup_file "${ROS_SETUP}"
cd "${WORKSPACE_DIR}"

if [[ "${RUN_ROSDEP}" == "ON" ]]; then
  rosdep update
  rosdep install --from-paths src --ignore-src -y
fi

colcon build --packages-select micro_ros_setup
source_setup_file "${WORKSPACE_DIR}/install/local_setup.bash"

if [[ ! -d "${WORKSPACE_DIR}/firmware" ]]; then
  ros2 run micro_ros_setup create_firmware_ws.sh generate_lib
fi

# Extra interface packages (from examples/ and any explicitly listed) are copied
# into the firmware workspace so generate_lib compiles them into libmicroros.
#
# NOTE: firmware/mcu_ws/extra_packages/ is micro_ros_setup's own config tree
# (generic/, esp32/, nucleo_*/ ...). Never wipe it — replace only the specific
# package directories we add. When a package is (re)copied, wipe the mcu_ws
# build/install so type supports for changed .msg/.srv regenerate.
ROSETTE_PKG_DIR="${WORKSPACE_DIR}/firmware/mcu_ws/rosette_packages"
mkdir -p "${ROSETTE_PKG_DIR}"
_rosette_copied_pkgs=0
while IFS= read -r package_dir; do
  [[ -n "${package_dir}" && -f "${package_dir}/package.xml" ]] || continue
  name="$(basename "${package_dir}")"
  echo "micro-ROS: including interface package ${name}"
  rm -rf "${ROSETTE_PKG_DIR:?}/${name}"
  cp -a "${package_dir%/}" "${ROSETTE_PKG_DIR}/"
  _rosette_copied_pkgs=1
done <<'ROSETTE_INTERFACE_PACKAGES_EOF'
@ROSETTE_MICRO_ROS_INTERFACE_PACKAGES@
ROSETTE_INTERFACE_PACKAGES_EOF

if [[ "${_rosette_copied_pkgs}" -eq 1 ]]; then
  rm -rf "${WORKSPACE_DIR}/firmware/mcu_ws/build" \
         "${WORKSPACE_DIR}/firmware/mcu_ws/install" \
         "${WORKSPACE_DIR}/firmware/build"
fi

patch_libyaml_vendor_for_cmake4 \
  "${WORKSPACE_DIR}/firmware/mcu_ws/ros2/libyaml_vendor/CMakeLists.txt"
patch_libyaml_vendor_for_cmake4 \
  "${WORKSPACE_DIR}/firmware/mcu_ws/uros/libyaml_vendor/CMakeLists.txt"

if [[ "@ROSETTE_MICRO_ROS_USE_PICO_TIME_TEXT@" == "ON" ]]; then
  patch_rcutils_for_pico_time \
    "${WORKSPACE_DIR}/firmware/mcu_ws/uros/rcutils"
  patch_rcutils_for_pico_time \
    "${WORKSPACE_DIR}/firmware/mcu_ws/ros2/rcutils"
fi

ros2 run micro_ros_setup build_firmware.sh "${TOOLCHAIN_FILE}" "${COLCON_META_FILE}"
