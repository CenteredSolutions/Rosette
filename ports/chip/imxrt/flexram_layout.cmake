# ports/chip/imxrt/flexram_layout.cmake — a board's FlexRAM layout: the
# linker MEMORY regions and the reset handler that applies it.
#
# The FlexRAM is the part's on-chip RAM as 32 KiB banks, each serving as
# ITCM, DTCM, or OCRAM. The fuses pick a layout the boot ROM applies; a board
# that wants another sets ROSETTE_IMXRT_FLEXRAM_ITCM_KIB, _DTCM_KIB, and
# _OCRAM_KIB in its board.cmake, and port.cmake calls
# rosette_imxrt_flexram_layout(). The layout then exists in two places that
# must agree, and both come from these three numbers:
#
#   - the linker's MEMORY regions: a copy of the SDK's flash linker script
#     with the LENGTH of m_qacode (ITCM), m_data (DTCM), and m_data2 (OCRAM)
#     rewritten, so the main stack's top (the end of m_data) and every
#     section's placement follow the layout;
#   - IOMUXC_GPR17.FLEXRAM_BANK_CFG, which flexram_reset_handler.S writes
#     before the stack is used. Banks are assigned in NXP's order (OCRAM from
#     bank 0, then DTCM, then ITCM), as FLEXRAM_AllocateRam() does.
#
# Defined for the MIMXRT1021, whose 256 KiB of on-chip RAM is all FlexRAM:
# eight banks, and the SDK script's m_data2 is the FlexRAM's OCRAM. A TCM is
# 0 KiB or a power of two from 32 KiB, which the TCM interfaces require.
#
# References:
# - i.MX RT1020 Processor Reference Manual, FlexRAM chapter; system memory
#   map (ITCM at 0x00000000, DTCM at 0x20000000, OCRAM at 0x20200000).
# - MCUXpresso SDK MIMXRT1021 fsl_flexram_allocate.c FLEXRAM_AllocateRam().
# - NXP AN12077, "Using the i.MX RT FlexRAM".

# ld_var names the variable holding the SDK script's path; on return it holds
# the rewritten script's.
function(rosette_imxrt_flexram_layout ld_var)
  if(NOT ROSETTE_IMXRT_DEVICE STREQUAL "MIMXRT1021")
    message(FATAL_ERROR "ROSETTE_IMXRT_FLEXRAM_*_KIB: the FlexRAM layout is defined for the MIMXRT1021, "
                        "not ${ROSETTE_IMXRT_DEVICE}")
  endif()

  set(_bank_kib 32)
  set(_total_kib 256)
  set(_sum 0)
  foreach(_ram ITCM DTCM OCRAM)
    set(_kib "${ROSETTE_IMXRT_FLEXRAM_${_ram}_KIB}")
    if(NOT _kib MATCHES "^[0-9]+$")
      message(FATAL_ERROR "ROSETTE_IMXRT_FLEXRAM_${_ram}_KIB must be a number of KiB, not '${_kib}'")
    endif()

    math(EXPR _rem "${_kib} % ${_bank_kib}")
    if(NOT _rem EQUAL 0)
      message(FATAL_ERROR "ROSETTE_IMXRT_FLEXRAM_${_ram}_KIB (${_kib}) must be whole ${_bank_kib} KiB banks")
    endif()

    if(NOT _ram STREQUAL "OCRAM" AND NOT _kib MATCHES "^(0|32|64|128|256)$")
      message(FATAL_ERROR "ROSETTE_IMXRT_FLEXRAM_${_ram}_KIB (${_kib}) must be 0 or a power of two from 32")
    endif()

    math(EXPR _banks_${_ram} "${_kib} / ${_bank_kib}")
    math(EXPR _bytes_${_ram} "${_kib} * 1024" OUTPUT_FORMAT HEXADECIMAL)
    math(EXPR _sum "${_sum} + ${_kib}")
  endforeach()

  if(NOT _sum EQUAL _total_kib)
    message(FATAL_ERROR "The FlexRAM layout assigns ${_sum} KiB; the MIMXRT1021 has ${_total_kib} KiB")
  endif()

  # Two bits per bank: 01 OCRAM, 10 DTCM, 11 ITCM; OCRAM from bank 0.
  set(_cfg 0)
  set(_bank 0)
  foreach(_ram_code OCRAM:1 DTCM:2 ITCM:3)
    string(REPLACE ":" ";" _pair "${_ram_code}")
    list(GET _pair 0 _ram)
    list(GET _pair 1 _code)
    foreach(_unused RANGE 1 ${_banks_${_ram}})
      if(_banks_${_ram} EQUAL 0)
        break()
      endif()

      math(EXPR _cfg "${_cfg} | (${_code} << (2 * ${_bank}))")
      math(EXPR _bank "${_bank} + 1")
    endforeach()
  endforeach()

  math(EXPR _cfg "${_cfg}" OUTPUT_FORMAT HEXADECIMAL)

  # The SDK script with each region's LENGTH set to the layout; a region the
  # pattern misses would leave the fuse layout's size, so each must match once.
  file(READ "${${ld_var}}" _script)
  foreach(_region_ram m_qacode:ITCM m_data:DTCM m_data2:OCRAM)
    string(REPLACE ":" ";" _pair "${_region_ram}")
    list(GET _pair 0 _region)
    list(GET _pair 1 _ram)
    set(_pattern "(\n[ \t]*${_region}[ \t]+\\([A-Z]+\\)[ \t]*:[ \t]*ORIGIN = 0x[0-9A-Fa-f]+, LENGTH = )0x[0-9A-Fa-f]+")
    string(REGEX MATCHALL "${_pattern}" _found "${_script}")
    list(LENGTH _found _count)
    if(NOT _count EQUAL 1)
      message(FATAL_ERROR "${${ld_var}}: expected one MEMORY line for ${_region}, found ${_count}")
    endif()

    string(REGEX REPLACE "${_pattern}" "\\1${_bytes_${_ram}}" _script "${_script}")
  endforeach()

  set(_out "${CMAKE_BINARY_DIR}/rosette_imxrt_flexram_memory.ld")
  file(WRITE "${_out}"
    "/* Generated by ports/chip/imxrt/flexram_layout.cmake from ${${ld_var}}: */\n"
    "/* ITCM ${ROSETTE_IMXRT_FLEXRAM_ITCM_KIB} KiB, DTCM ${ROSETTE_IMXRT_FLEXRAM_DTCM_KIB} KiB, "
    "OCRAM ${ROSETTE_IMXRT_FLEXRAM_OCRAM_KIB} KiB; FLEXRAM_BANK_CFG ${_cfg}. */\n"
    "${_script}")
  set(${ld_var} "${_out}" PARENT_SCOPE)

  target_sources(rosette_platform PRIVATE ${ROSETTE_PORT_DIR}/flexram_reset_handler.S)
  set_source_files_properties(${ROSETTE_PORT_DIR}/flexram_reset_handler.S PROPERTIES LANGUAGE ASM)
  target_compile_definitions(rosette_platform PRIVATE ROSETTE_IMXRT_FLEXRAM_BANK_CFG=${_cfg})
  target_link_options(rosette_platform INTERFACE -Wl,-u,rosette_imxrt_flexram_reset_handler)
  message(STATUS "i.MX RT FlexRAM: ITCM ${ROSETTE_IMXRT_FLEXRAM_ITCM_KIB} KiB, "
                 "DTCM ${ROSETTE_IMXRT_FLEXRAM_DTCM_KIB} KiB, OCRAM ${ROSETTE_IMXRT_FLEXRAM_OCRAM_KIB} KiB "
                 "(FLEXRAM_BANK_CFG ${_cfg})")
endfunction()
