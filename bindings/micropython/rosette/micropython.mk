ROSETTE_BINDINGS_ROOT := $(USER_C_MODULES)
ROSETTE_BINDINGS_MOD_DIR := $(USERMOD_DIR)
ROSETTE_REPO_DIR ?= $(abspath $(ROSETTE_BINDINGS_ROOT)/../..)
ROSETTE_MICRO_ROS_TRANSPORT ?= udp
ROSETTE_MICRO_ROS_INCLUDE_DIR ?=
ROSETTE_MICRO_ROS_LIBRARY ?=

ROSETTE_MICRO_ROS_CACHE_FILE := $(ROSETTE_REPO_DIR)/build-micro-ros/CMakeCache.txt
ifeq ($(strip $(ROSETTE_MICRO_ROS_INCLUDE_DIR)),)
ifneq ($(wildcard $(ROSETTE_MICRO_ROS_CACHE_FILE)),)
ROSETTE_MICRO_ROS_INCLUDE_DIR := $(strip $(shell sed -n 's/^ROSETTE_MICRO_ROS_INCLUDE_DIR:PATH=//p' "$(ROSETTE_MICRO_ROS_CACHE_FILE)" | head -n 1))
endif
endif
ifeq ($(strip $(ROSETTE_MICRO_ROS_LIBRARY)),)
ifneq ($(wildcard $(ROSETTE_MICRO_ROS_CACHE_FILE)),)
ROSETTE_MICRO_ROS_LIBRARY := $(strip $(shell sed -n 's/^ROSETTE_MICRO_ROS_LIBRARY:FILEPATH=//p' "$(ROSETTE_MICRO_ROS_CACHE_FILE)" | head -n 1))
endif
endif

ROSETTE_MICROPY_HAS_MICRO_ROS := 0
ifneq ($(strip $(ROSETTE_MICRO_ROS_INCLUDE_DIR)),)
ifneq ($(strip $(ROSETTE_MICRO_ROS_LIBRARY)),)
ifneq ($(wildcard $(ROSETTE_MICRO_ROS_INCLUDE_DIR)/rcl/rcl.h),)
ifneq ($(wildcard $(ROSETTE_MICRO_ROS_LIBRARY)),)
ROSETTE_MICROPY_HAS_MICRO_ROS := 1
endif
endif
endif
endif

SRC_USERMOD += $(ROSETTE_BINDINGS_ROOT)/modrosette.c
SRC_USERMOD_CXX += \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_backend_runtime.cpp \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_context.cpp \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_node.cpp \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_pubsub.cpp \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_schema.cpp \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_transport.cpp \
	$(ROSETTE_BINDINGS_ROOT)/rosette_mpy_stream.cpp

CFLAGS_USERMOD += \
	-DROSETTE_MICROPY_HAS_MICRO_ROS=$(ROSETTE_MICROPY_HAS_MICRO_ROS) \
	-DROSETTE_MICROPY_BACKEND_TRANSPORT_CUSTOM=$(if $(filter custom,$(ROSETTE_MICRO_ROS_TRANSPORT)),1,0) \
	-I$(ROSETTE_BINDINGS_ROOT) \
	-I$(ROSETTE_REPO_DIR) \
	-I$(ROSETTE_REPO_DIR)/include

CXXFLAGS_USERMOD += \
	-DROSETTE_MICROPY_HAS_MICRO_ROS=$(ROSETTE_MICROPY_HAS_MICRO_ROS) \
	-DROSETTE_MICROPY_BACKEND_TRANSPORT_CUSTOM=$(if $(filter custom,$(ROSETTE_MICRO_ROS_TRANSPORT)),1,0) \
	-I$(ROSETTE_BINDINGS_ROOT) \
	-I$(ROSETTE_REPO_DIR) \
	-I$(ROSETTE_REPO_DIR)/include \
	-std=gnu++17

ifneq ($(ROSETTE_MICROPY_HAS_MICRO_ROS),0)
CFLAGS_USERMOD += -I$(ROSETTE_MICRO_ROS_INCLUDE_DIR)
CXXFLAGS_USERMOD += -I$(ROSETTE_MICRO_ROS_INCLUDE_DIR)
LDFLAGS_USERMOD += $(ROSETTE_MICRO_ROS_LIBRARY)
endif

LDFLAGS_USERMOD += -lstdc++

# Freeze the pure-Python rosette sub-package so it is available as
# `from rosette.async import ...` without needing files on the filesystem.
FROZEN_MANIFEST ?=
SRC_USERMOD_FROZEN += $(ROSETTE_BINDINGS_MOD_DIR)/async.py
