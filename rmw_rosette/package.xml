<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmw_rosette</name>
  <version>0.0.1</version>
  <description>
    rmw implementation backed by Rosette's embedded DDSI-RTPS stack.

    Lets a microcontroller running stock rcl/rclc join the ROS 2 graph as a
    real RTPS participant, without a micro-ROS Agent process in the loop.
    Serialization is delegated to the rosidl-generated
    rosidl_typesupport_microxrcedds_c callbacks already produced by
    micro_ros_setup; this package only implements the rmw C ABI on top of
    rosette::rtps.
  </description>
  <maintainer email="gravydish@gmail.com">Jared Hancock</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcutils</depend>
  <depend>rmw</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_typesupport_microxrcedds_c</depend>

  <!-- TODO: this should vendor or depend on the rosette::rtps static lib
       (include/rosette/rtps, src/rtps at the repo root) rather than
       re-declaring it here. Until the cross-build wiring in
       cmake/micro_ros.cmake pulls it in, treat this as unresolved. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rmw_implementation_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    <rmw_implementation />
  </export>
</package>
