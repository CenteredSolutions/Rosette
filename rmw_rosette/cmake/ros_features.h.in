/**
 * @file rmw_rosette/ros_features.h
 * @brief ROS 2 API features present in the headers this build compiles against.
 *
 * Generated by rmw_rosette/cmake/rmw_rosette_ros_features.cmake, which documents
 * each probe and the header that defines its feature. Code tests a feature with
 * `#if RMW_ROSETTE_HAS(CLIENT_GID)`, which evaluates to 0 or 1.
 *
 * The test is a function-like macro so that a mistake fails to compile under any
 * compiler, with no warning flags. A misspelled feature pastes into an undefined
 * name, which `#if` replaces with 0, leaving `(0())`; a file that forgets this
 * include leaves `0(CLIENT_GID)`. Neither is a valid preprocessor expression,
 * where a plain `#if RMW_ROSETTE_HAS_CLIENT_GUID` would silently evaluate to 0.
 * This is the pattern of Chromium's BUILDFLAG() (build/buildflag.h).
 */

#pragma once

/// @brief 1 when the ROS 2 headers provide @p feature, 0 when they do not.
#define RMW_ROSETTE_HAS(feature) (RMW_ROSETTE_FEATURE_##feature())

/// `rmw_init_options_t::discovery_options` exists (rmw/discovery_options.h).
#define RMW_ROSETTE_FEATURE_DISCOVERY_OPTIONS() (@RMW_ROSETTE_HAS_DISCOVERY_OPTIONS@)

/// `rosidl_message_type_support_t::get_type_hash_func` exists (rosidl_runtime_c/type_hash.h).
#define RMW_ROSETTE_FEATURE_TYPE_HASH() (@RMW_ROSETTE_HAS_TYPE_HASH@)

/// `rmw_count_clients` and `rmw_count_services` are declared (rmw/rmw.h).
#define RMW_ROSETTE_FEATURE_SERVICE_ENDPOINT_COUNTS() (@RMW_ROSETTE_HAS_SERVICE_ENDPOINT_COUNTS@)

/// `rmw_get_gid_for_client` is declared (rmw/rmw.h).
#define RMW_ROSETTE_FEATURE_CLIENT_GID() (@RMW_ROSETTE_HAS_CLIENT_GID@)

/// `rmw_event_type_is_supported` is declared (rmw/event.h).
#define RMW_ROSETTE_FEATURE_EVENT_TYPE_QUERY() (@RMW_ROSETTE_HAS_EVENT_TYPE_QUERY@)

/// `rmw_take_dynamic_message` and its family are declared (rmw/dynamic_message_type_support.h).
#define RMW_ROSETTE_FEATURE_DYNAMIC_TYPESUPPORT() (@RMW_ROSETTE_HAS_DYNAMIC_TYPESUPPORT@)

/// The BEST_AVAILABLE reliability, durability and liveliness policies exist (rmw/types.h).
#define RMW_ROSETTE_FEATURE_QOS_BEST_AVAILABLE() (@RMW_ROSETTE_HAS_QOS_BEST_AVAILABLE@)
