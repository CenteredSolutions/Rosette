{
  "spec": {
    "name": "OMG DDSI-RTPS",
    "version": "2.5",
    "document": "formal/2022-04-01"
  },
  "target": "lib/Rosette/include/rosette/rtps/fragment_assembler.hpp",
  "scope": [
    "8.3.3.1",
    "8.4.12",
    "8.4.14",
    "9.4.2.8",
    "9.4.5.4"
  ],
  "statements": [
    {
      "id": "REQ-FAS-8.4.14-COMPLETE-CACHECHANGE",
      "section": "8.4.14",
      "page": 156,
      "normativity": "shall",
      "statement": "Fragment assembler returns a complete CacheChange when all fragments for a sample are received.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.14-001"]
    },
    {
      "id": "REQ-FAS-8.4.14-OUTOFORDER-REASSEMBLY",
      "section": "8.4.14",
      "page": 156,
      "normativity": "shall",
      "statement": "Fragment assembler accepts out-of-order DATA_FRAG fragments and assembles payload by fragment number.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.14-002"]
    },
    {
      "id": "REQ-FAS-9.4.5.4-FRAGMENT-START-ONE-BASED",
      "section": "9.4.5.4",
      "page": 208,
      "normativity": "shall",
      "statement": "fragmentStartingNum is 1-based and zero-valued fragment numbers are rejected.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.14-003"]
    },
    {
      "id": "REQ-FAS-9.4.2.8-FRAGMENT-BITMAP-LIMIT",
      "section": "9.4.2.8",
      "page": 199,
      "normativity": "derived-invariant",
      "statement": "Fragment reassembly enforces the 256-bit FragmentNumberSet limit in current MVP implementation.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.14-004"]
    },
    {
      "id": "REQ-FAS-8.4.14-DISCARD-LIFECYCLE",
      "section": "8.4.14",
      "page": 156,
      "normativity": "implementation-behavior",
      "statement": "discard() and discard_writer() clear in-flight FragmentedChange state and release associated slots.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.14-005"]
    },
    {
      "id": "REQ-FAS-8.4.12-MISSING-FRAGMENT-SET",
      "section": "8.4.12",
      "page": 153,
      "normativity": "shall",
      "statement": "Missing fragment computation returns the FragmentNumberSet of not-yet-received fragments up to last known fragment.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.12-001"]
    },
    {
      "id": "REQ-FAS-8.4.12-MISSING-REQUIRES-SLOT",
      "section": "8.4.12",
      "page": 153,
      "normativity": "derived-precondition",
      "statement": "Missing fragment computation is only available for an existing in-flight fragmented sample.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.4.12-002"]
    },
    {
      "id": "REQ-FAS-8.3.3.1-KEEP-LAST-EVICTION",
      "section": "8.3.3.1",
      "page": 68,
      "normativity": "shall",
      "statement": "KEEP_LAST(1) policy evicts older in-flight sample state for the same writer when a newer sequence number arrives.",
      "status": "implemented",
      "test_ids": ["TC-FAS-8.3.3.1-001"]
    }
  ]
}
