  "statements": [
    {
      "id": "REQ-SWR-8.2.2-8.3.1-HISTORY-REMOVE-INTERACTION",
      "section": "8.2.2",
      "page": 26,
      "normativity": "shall",
      "statement": "WriterHistoryCache and ReaderProxy change tracking remain coherent when a CacheChange is removed from history.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.2.2-001"]
    },
    {
      "id": "REQ-SWR-8.2.2-8.4.2.2-HISTORY-HEARTBEAT-RANGE",
      "section": "8.2.2",
      "page": 26,
      "normativity": "shall",
      "statement": "StatefulWriter HEARTBEAT firstSN/lastSN is derived from the current WriterHistoryCache sequence-number bounds.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.2.2-002"]
    },
    {
      "id": "REQ-SWR-8.2.2-8.4.3-HISTORY-RETRANSMIT",
      "section": "8.2.2",
      "page": 26,
      "normativity": "shall",
      "statement": "ACKNACK-requested changes are retransmitted from WriterHistoryCache after nackResponseDelay processing.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.2.2-003"]
    },
    {
      "id": "REQ-SWR-8.4.1.4-ADD-CHANGE-SN",
      "section": "8.4.1.4",
      "page": 107,
      "normativity": "shall",
      "statement": "add_change assigns monotonically increasing sequence numbers and inserts changes into the writer HistoryCache.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.1.4-001"]
    },
    {
      "id": "REQ-SWR-8.3.3-KEEP-LAST-EVICTION",
      "section": "8.3.3",
      "page": 68,
      "normativity": "shall",
      "statement": "KEEP_LAST cache depth evicts oldest changes when full.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.1.4-001"]
    },
    {
      "id": "REQ-SWR-8.4.1.4-MATCHED-READER-SEND",
      "section": "8.4.1.4",
      "page": 108,
      "normativity": "shall",
      "statement": "matched_reader_add enables subsequent data sends to a matched reader locator.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.1.4-002"]
    },
    {
      "id": "REQ-SWR-8.7.2.2-TRANSIENT-LOCAL-REPLAY",
      "section": "8.7.2.2",
      "page": 196,
      "normativity": "shall",
      "statement": "TRANSIENT_LOCAL matched readers receive replay-marked cached changes.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.1.4-003"]
    },
    {
      "id": "REQ-SWR-8.4.2.2-PERIODIC-HEARTBEAT",
      "section": "8.4.2.2",
      "page": 113,
      "normativity": "shall",
      "statement": "tick() emits periodic HEARTBEAT messages according to heartbeatPeriod.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.2.2-001"]
    },
    {
      "id": "REQ-SWR-8.4.3-ACKNACK-PROCESSING",
      "section": "8.4.3",
      "page": 118,
      "normativity": "shall",
      "statement": "on_acknack processes cumulative acknowledgment state and ignores duplicate count values.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.3-001"]
    },
    {
      "id": "REQ-SWR-8.4.4-NACK-FRAG-DEFERRED-RESPONSE",
      "section": "8.4.4",
      "page": 122,
      "normativity": "shall",
      "statement": "on_nack_frag arms deferred retransmit and tick() sends requested data after nackResponseDelay.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.4-001"]
    },
    {
      "id": "REQ-SWR-8.4.6-REQUESTED-CHANGES",
      "section": "8.4.6",
      "page": 128,
      "normativity": "shall",
      "statement": "requested_changes_set marks NACKed changes REQUESTED, next_requested_change returns the lowest REQUESTED change, and acked_changes_set clears acknowledged requests.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.6-001"]
    },
    {
      "id": "REQ-SWR-8.4.6-UNSENT-CHANGES",
      "section": "8.4.6",
      "page": 128,
      "normativity": "shall",
      "statement": "next_unsent_change returns the lowest UNSENT change relevant to the reader, and unacked_changes is non-empty until the newest relevant change is acknowledged.",
      "status": "implemented",
      "test_ids": ["TC-SWR-8.4.6-002"]
    }
  ]
}
