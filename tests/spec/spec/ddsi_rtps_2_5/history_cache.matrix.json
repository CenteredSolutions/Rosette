      "id": "REQ-HC-8.3.1-CORE-OPS",
      "section": "8.3.1",
      "page": 63,
      "normativity": "shall",
      "statement": "HistoryCache add_change/get_change/get_seq_num_min/get_seq_num_max/is_empty/size operations expose consistent cache state.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.3.1-001"]
    },
    {
      "id": "REQ-HC-8.3.3.1-KEEP-LAST-SAME-WRITER-EVICT",
      "section": "8.3.3.1",
      "page": 68,
      "normativity": "shall",
      "statement": "When full, KEEP_LAST-style insertion evicts the oldest change for the same writer.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.3.3.1-001"]
    },
    {
      "id": "REQ-HC-8.3.3.1-KEEP-LAST-GLOBAL-EVICT-FALLBACK",
      "section": "8.3.3.1",
      "page": 68,
      "normativity": "shall",
      "statement": "When full and no same-writer entry exists, insertion evicts the globally oldest change as implementation fallback.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.3.3.1-002"]
    },
    {
      "id": "REQ-HC-8.3.1-REMOVE-CHANGE",
      "section": "8.3.1",
      "page": 63,
      "normativity": "shall",
      "statement": "remove_change removes present sequence-number entries and returns false when no such change exists.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.3.1-002"]
    },
    {
      "id": "REQ-HC-8.3.1-ITERATION",
      "section": "8.3.1",
      "page": 63,
      "normativity": "shall",
      "statement": "HistoryCache iteration traverses each live CacheChange exactly once for const and mutable visitor forms.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.3.1-003"]
    },
    {
      "id": "REQ-HC-8.2.2-8.7.2.2-REPLAY-ORDER",
      "section": "8.2.2",
      "page": 26,
      "normativity": "shall",
      "statement": "Writer history replay to newly matched readers walks cached changes in ascending sequence-number order.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.2.2-001"]
    },
    {
      "id": "REQ-HC-8.3.1-CLEAR-ALL",
      "section": "8.3.1",
      "page": 63,
      "normativity": "shall",
      "statement": "clear_all removes all cache entries and resets observable empty and sequence-bound state.",
      "status": "implemented",
      "test_ids": ["TC-HC-8.3.1-004"]
    }
