      "section": "8.3.7.5",
      "page": 91,
      "normativity": "shall",
      "statement": "HEARTBEAT processing requests ACKNACK when changes are missing, and immediate ACKNACK is sent when heartbeatResponseDelay is zero.",
      "status": "implemented",
      "test_ids": ["TC-SRR-8.4.9-001"]
